{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hack-hydra.local/schemas/graph-ir.schema.json",
  "title": "Hack Hydra Graph IR",
  "type": "object",
  "required": ["version", "repository_id", "revision_id", "nodes", "edges", "diagnostics"],
  "properties": {
    "version": { "const": "1.0" },
    "repository_id": { "type": "string", "minLength": 1 },
    "revision_id": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "span": {
      "type": "object",
      "required": ["start_line", "start_column", "end_line", "end_column"],
      "properties": {
        "start_line": { "type": "integer", "minimum": 1 },
        "start_column": { "type": "integer", "minimum": 0 },
        "end_line": { "type": "integer", "minimum": 1 },
        "end_column": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "path", "span", "excerpt_hash", "explanation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "span": { "$ref": "#/$defs/span" },
        "excerpt_hash": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "kind", "display_name", "qualified_name", "path", "revision_id", "parser", "parser_version", "is_generated", "attributes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "qualified_name": { "type": "string", "minLength": 1 },
        "language": { "type": ["string", "null"] },
        "path": { "type": "string", "minLength": 1 },
        "span": { "anyOf": [{ "$ref": "#/$defs/span" }, { "type": "null" }] },
        "signature": { "type": ["string", "null"] },
        "revision_id": { "type": "string", "minLength": 1 },
        "content_hash": { "type": ["string", "null"] },
        "parser": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string", "minLength": 1 },
        "is_generated": { "type": "boolean" },
        "attributes": { "type": "object" }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["id", "source_id", "predicate", "target_id", "quality", "evidence", "revision_id", "extractor", "extractor_version", "attributes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1, "maxLength": 256 },
        "target_id": { "type": "string", "minLength": 1 },
        "quality": { "enum": ["exact", "inferred", "semantic", "unknown"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "revision_id": { "type": "string", "minLength": 1 },
        "extractor": { "type": "string", "minLength": 1 },
        "extractor_version": { "type": "string", "minLength": 1 },
        "attributes": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
