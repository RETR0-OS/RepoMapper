{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hack-hydra.local/schemas/product-view.schema.json",
  "title": "Hack Hydra Product View",
  "type": "object",
  "required": ["view_id", "revision_id", "mode", "nodes", "edges", "aggregates", "hydradb", "warnings", "budget"],
  "properties": {
    "view_id": { "type": "string", "minLength": 1 },
    "revision_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["repository", "explore", "trace", "observe", "compare", "preserve"] },
    "depth": { "enum": ["package", "file", "symbol"] },
    "nodes": { "type": "array", "items": { "$ref": "graph-ir.schema.json#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "graph-ir.schema.json#/$defs/edge" } },
    "aggregates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_group_id", "predicate", "target_group_id", "exact_relation_count", "contributing_edge_ids", "contributing_evidence_ids", "revision_id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source_group_id": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 },
          "target_group_id": { "type": "string", "minLength": 1 },
          "exact_relation_count": { "type": "integer", "minimum": 1 },
          "contributing_edge_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "contributing_evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "revision_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "hydradb": {
      "type": "object",
      "required": ["available", "collections", "graph_context"],
      "properties": {
        "available": { "type": "boolean" },
        "collections": { "type": "array", "items": { "type": "string" } },
        "query_by": { "type": ["string", "null"] },
        "mode": { "type": ["string", "null"] },
        "graph_context": { "type": "boolean" },
        "path_ids": { "type": "array", "items": { "type": "string" } },
        "origin": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "budget": {
      "type": "object",
      "required": ["requested_nodes", "returned_nodes", "requested_edges", "returned_edges", "truncated"],
      "properties": {
        "requested_nodes": { "type": "integer", "minimum": 0 },
        "returned_nodes": { "type": "integer", "minimum": 0 },
        "requested_edges": { "type": "integer", "minimum": 0 },
        "returned_edges": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
