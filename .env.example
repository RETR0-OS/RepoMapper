# Required for HydraDB-backed indexing and retrieval.
HYDRA_DB_API_KEY=
HYDRA_DB_DATABASE=

# Optional HydraDB settings.
HYDRA_DB_COLLECTION=current
HYDRA_DB_EVOLUTION_COLLECTION=evolution
HYDRA_DB_API_URL=https://api.hydradb.com
HYDRA_DB_TIMEOUT_SECONDS=20
HYDRA_DB_MAX_RETRIES=2
HYDRA_DB_RETRY_BACKOFF_SECONDS=0.25
HYDRA_DB_POLL_INTERVAL_SECONDS=1
HYDRA_DB_POLL_TIMEOUT_SECONDS=120

# Repository scope for the local service. Use an absolute path when the
# service is started outside the repository root.
HYDRA_REPOSITORY_ID=hack-hydra
HYDRA_REPOSITORY_ROOT=.
