{
  "name": "hydra-repository-observability",
  "displayName": "Argus",
  "description": "HydraDB-backed repository observability for agentic coding.",
  "version": "0.1.0",
  "publisher": "hack-hydra",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/RETR0-OS/Argus.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onView:hydra.currentSymbol",
    "onCommand:hydra.openRepositoryMap",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "preview": "npm run build && node preview-server.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "diagnose": "node ../scripts/diagnose_managed.mjs",
    "package": "vsce package"
  },
  "contributes": {
    "commands": [
      {
        "command": "hydra.openRepositoryMap",
        "title": "Open Argus",
        "category": "Argus"
      },
      {
        "command": "hydra.showInRepositoryMap",
        "title": "Show in Argus",
        "category": "Argus"
      },
      {
        "command": "hydra.showCallersAndCallees",
        "title": "Show Callers and Callees",
        "category": "Argus"
      },
      {
        "command": "hydra.traceFlowFromHere",
        "title": "Trace Flow from Here",
        "category": "Argus"
      },
      {
        "command": "hydra.findTests",
        "title": "Find Tests for This Symbol",
        "category": "Argus"
      },
      {
        "command": "hydra.askAboutCode",
        "title": "Ask HydraDB About This Code",
        "category": "Argus"
      },
      {
        "command": "hydra.compareGraph",
        "title": "Start or Finish Comparison",
        "category": "Argus"
      },
      {
        "command": "hydra.saveSystemLens",
        "title": "Save as System Lens",
        "category": "Argus"
      },
      {
        "command": "hydra.followAgent",
        "title": "Follow Agent",
        "category": "Argus"
      },
      {
        "command": "hydra.refresh",
        "title": "Refresh Argus",
        "category": "Argus",
        "icon": "$(refresh)"
      },
      {
        "command": "hydra.configureService",
        "title": "Configure Argus",
        "category": "Argus"
      },
      {
        "command": "hydra.setup",
        "title": "Set Up Argus",
        "category": "Argus"
      },
      {
        "command": "hydra.configureAgents",
        "title": "Configure Agents",
        "category": "Argus"
      },
      {
        "command": "hydra.reviewIdentity",
        "title": "Review Repository Identity",
        "category": "Argus"
      },
      {
        "command": "hydra.replaceApiKey",
        "title": "Replace HydraDB API Key",
        "category": "Argus"
      },
      {
        "command": "hydra.removeProjectBinding",
        "title": "Remove Project Database Binding",
        "category": "Argus"
      },
      {
        "command": "hydra.indexRepository",
        "title": "Index Workspace with HydraDB",
        "category": "Argus",
        "icon": "$(cloud-upload)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "hydra.showInRepositoryMap",
          "group": "navigation@90"
        },
        {
          "command": "hydra.showCallersAndCallees",
          "group": "navigation@91"
        },
        {
          "command": "hydra.traceFlowFromHere",
          "group": "navigation@92"
        },
        {
          "command": "hydra.findTests",
          "group": "navigation@93"
        },
        {
          "command": "hydra.askAboutCode",
          "group": "navigation@94"
        }
      ],
      "view/title": [
        {
          "command": "hydra.refresh",
          "when": "view =~ /hydra\\./",
          "group": "navigation"
        },
        {
          "command": "hydra.indexRepository",
          "when": "view =~ /hydra\\./",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hydra.repositoryMap",
          "title": "Argus",
          "icon": "media/repository-map.svg"
        }
      ]
    },
    "views": {
      "hydra.repositoryMap": [
        {
          "id": "hydra.currentSymbol",
          "name": "Current Symbol"
        },
        {
          "id": "hydra.entrypoints",
          "name": "Entrypoints"
        },
        {
          "id": "hydra.savedLenses",
          "name": "Saved System Lenses"
        },
        {
          "id": "hydra.recentChanges",
          "name": "Recent Graph Changes"
        },
        {
          "id": "hydra.agentActivity",
          "name": "Agent Activity"
        },
        {
          "id": "hydra.indexStatus",
          "name": "HydraDB Index Status"
        }
      ]
    },
    "configuration": {
      "title": "Argus",
      "properties": {
        "hydra.developerMode": {
          "type": "boolean",
          "default": false,
          "description": "Use a separately started development service instead of the bundled managed service. Not intended for normal use."
        },
        "hydra.developerServiceUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Loopback service URL used only when Argus developer mode is enabled."
        },
        "hydra.requestTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 500,
          "maximum": 300000,
          "description": "Timeout for local service read requests. Every view runs a HydraDB thinking-mode query with graph context, which takes tens of seconds on a large repository. Keep this above the service's own 90 s HydraDB budget, or the view is cancelled before HydraDB answers."
        },
        "hydra.indexTimeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 5000,
          "maximum": 1800000,
          "description": "Timeout for repository analysis and for each indexing job status request. It does not bound the whole upload, which runs as a background job in the local service."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.2",
    "@vitest/coverage-v8": "^3.0.4",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.4"
  }
}
